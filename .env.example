# =============================================================================
# Pull-API-v2 — environment variables template
# =============================================================================
#
# Copy this file to `.env` (gitignored) and fill in real values.
# Real secrets never go to git.
#
# The Aurora Hall demo has the live values stored as Fly.io secrets on app
# `pull-api-v2-demo`. To recover them:
#
#   flyctl secrets list --app pull-api-v2-demo   # names + digests only
#   flyctl ssh console --app pull-api-v2-demo    # then `env | grep <NAME>`
#
# Fly does NOT expose secret values in `secrets list`. Options to recover
# real values on a new machine:
#   1. `flyctl ssh console` + `env | grep <NAME>` on the running Fly VM.
#   2. Read them from the Supabase / Cloudflare / Brevo dashboards.
#   3. Ask a teammate — they're in your team's shared password manager.
#
# =============================================================================

# ---------- APP ----------

# Runtime. Change to `development` for extra logging + lenient CORS.
ENVIRONMENT=production

# HTTP port. `fly.toml [http_service] internal_port` must match.
PORT=8080

# Enable the mock Stripe processor (services/mock_processor.go).
# ALWAYS true in the Aurora Hall demo.
DEMO_MODE=true

# JWT signing secret. Any random 32+ char string.
#   openssl rand -hex 32
# CRITICAL: rotating this invalidates every issued JWT (all staff sessions).
JWT_SECRET=

# AES-256-GCM key for encrypting/decrypting venue Supabase credentials in
# the central DB. MUST be exactly 64 hex chars (256 bits).
#   openssl rand -hex 32
# CRITICAL: rotating this makes every stored `venue_database_configs` row
# unreadable. Only rotate if you plan to re-encrypt every venue row.
APP_KEY=

# CORS. Comma-separated list of allowed origins.
ALLOWED_ORIGINS=https://aurora-hall.pages.dev,https://pull-api-v2-demo.fly.dev

# Cloudflare Turnstile (anti-carding CAPTCHA on POST /orders/pay).
# Empty = disabled. Only enable AFTER the WebApp renders the widget
# (VITE_TURNSTILE_SITE_KEY), or every payment will be rejected.
TURNSTILE_SECRET_KEY=

# Customer-facing WebApp base URL. Used in email templates + redirects.
FRONTEND_URL=https://aurora-hall.pages.dev

# Public URL of this API. Used in email links.
API_BASE_URL=https://pull-api-v2-demo.fly.dev

# Cookie SameSite. `None` for cross-origin auth cookies (requires HTTPS).
COOKIE_SAMESITE=None

# ---------- CENTRAL DB (Pull platform Supabase) ----------
# Holds `venues`, encrypted per-venue DB credentials, platform-level rows.
# One instance, shared across all tenants.

# https://<project-ref>.supabase.co
# Supabase dashboard → Project Settings → API → Project URL.
CENTRAL_SUPABASE_URL=https://dqqvtehpidihahzabcxg.supabase.co

# service_role key. Full RW access. NEVER ship to a browser.
# Supabase → Project Settings → API → service_role.
CENTRAL_SERVICE_KEY=

# anon key. Public-safe.
CENTRAL_ANON_KEY=

# ---------- DEFAULT VENUE DB (Aurora Hall demo) ----------
# The venue Supabase used by legacy compat paths as the "single-tenant
# fallback". In the Aurora demo it points at Aurora's own Supabase.

DEFAULT_SUPABASE_URL=https://oqqhffxwiizukkevzkvz.supabase.co
DEFAULT_SERVICE_KEY=
DEFAULT_ANON_KEY=

# Legacy aliases (v1 code that reads these instead of the DEFAULT_* set).
# Set them to the same values.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# ---------- REDIS (optional) ----------
# Used for rate-limiting and cache. Empty → in-memory (fine on single Fly
# machine; NOT fine if you scale to multiple machines).
REDIS_URL=

# ---------- EMAIL ----------

# Brevo (transactional) — the primary email provider.
# 300 emails/day free, no domain verification required.
# https://app.brevo.com/settings/keys/api → create key (`xkeysib-...`).
BREVO_API_KEY=
BREVO_FROM_EMAIL=Pull Events <noreply@tickets.pullevents.com>


# ---------- dLOCAL GO (pasarela ACTIVA desde ago-2026) ----------
# Es la que cobra de verdad. OJO: dLocal tiene DOS productos y las
# credenciales NO son intercambiables — el nuestro es dLocal Go
# (docs.dlocalgo.com), no dLocal Payins (docs.dlocal.com).
#
# Las credenciales por venue viven CIFRADAS en la tabla
# payment_gateway_credentials (central). Estas variables son el fallback
# y lo que usan los scripts de prueba.
#
# Panel: https://merchant.dlocalgo.com  →  Integración → Credenciales
DLOCAL_API_KEY=
DLOCAL_SECRET_KEY=
# production | sandbox. Si viene cualquier otra cosa, el cliente cae a
# SANDBOX a propósito: nunca debe cobrar de verdad por un typo.
DLOCAL_ENVIRONMENT=sandbox
# País del cobro (ISO-2). Guatemala.
DLOCAL_COUNTRY=GT
# Código de split para repartir el fee con el venue. Nuestro 8% es sobre
# la BASE del ticket, así que sobre el total cobrado son 7.4074% — ese es
# el porcentaje que hay que configurar en dLocal, NO el 8.
DLOCAL_SPLIT_CODE=
# Base pública para el notification_url de los webhooks. DEBE ser el
# dominio del backend, NO el de la web: el proxy de Cloudflare solo
# enruta /api/*, y el webhook vive en /webhooks/dlocal/:venue_id.
DLOCAL_NOTIFICATION_BASE_URL=
# Token opcional que se añade al notification_url y se valida al recibir.
DLOCAL_WEBHOOK_TOKEN=

# ---------- STRIPE (histórico, sin uso) ----------
# Nunca se llegó a usar. StripeProcessor devuelve error en todos sus
# métodos. Se conserva la constante porque hay filas antiguas con ese
# valor en payment_gateway. Dejar vacío.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- GOOGLE OAUTH (optional) ----------
# Only used if you enable Google login for customers. Not wired in demo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# DEVELOPMENT vs PRODUCTION notes
# =============================================================================
#
# DEVELOPMENT (ENVIRONMENT=development):
#   ✓ CORS allows ALL origins
#   ✓ IP block threshold raised to 20 failures
#   ✓ Localhost IPs never blocked
#   ✓ Error details in JSON responses
#   ✓ HSTS disabled
#   ✓ JWT_SECRET/APP_KEY validation relaxed (any string OK)
#   ✓ Emails logged instead of sent when BREVO_API_KEY is empty
#
# PRODUCTION (ENVIRONMENT=production):
#   ✗ Only ALLOWED_ORIGINS allowed
#   ✗ IP block after 5 failures
#   ✗ JWT_SECRET must be ≥32 chars
#   ✗ APP_KEY must be exactly 64 hex chars
#   ✗ Error details redacted
#   ✗ HSTS enabled
#   ✗ STRIPE_WEBHOOK_SECRET required when DEMO_MODE=false
#
# =============================================================================

# ---------- FCM (Android push) ----------
# El JSON ENTERO de la service account de Firebase, en una sola línea (en Fly va
# como secreto: flyctl secrets set FCM_SERVICE_ACCOUNT_JSON="$(cat sa.json)").
# Se saca en console.firebase.google.com → Configuración del proyecto → Cuentas
# de servicio → Generar nueva clave privada.
# Si falta, Android queda apagado y iOS (APNs, abajo) sigue funcionando: son dos
# plataformas independientes y ninguna necesita el secreto de la otra.
FCM_SERVICE_ACCOUNT_JSON=

# ---------- APNs (iOS push — feature-flag) ----------
# Notificaciones push a iPhones (staff en TestFlight/App Store). Si falta
# CUALQUIERA de estas, iOS push queda apagado y Android (FCM) sigue igual.
# La APNs Auth Key se crea en developer.apple.com → Keys → +  → marcar
# "Apple Push Notification service (APNs)". Da el .p8 (una descarga), Key ID
# y Team ID. Es a nivel de cuenta (una sola para todas las apps).
APNS_KEY_P8=          # contenido del .p8 (PEM con BEGIN/END PRIVATE KEY)
APNS_KEY_ID=          # Key ID de la APNs Auth Key (10 chars)
# APNS_TEAM_ID es el MISMO valor que PASS_TEAM_ID de más abajo (el Team ID es
# uno solo para toda la cuenta Apple): cópialo de ahí en vez de ir a buscarlo al
# portal.
APNS_TEAM_ID=
# APNS_BUNDLE_ID tiene que ser EXACTAMENTE el bundle del build instalado. Si no
# coincide, Apple rechaza TODOS los envíos con BadTopic/TopicDisallowed — y eso
# NO significa que los tokens estén muertos (por eso el backend ya no los
# desactiva por un 400 a secas; ver services/push.go).
APNS_BUNDLE_ID=com.pullevents.staff
# APNS_SANDBOX=true   # solo para dev builds; TestFlight/App Store = producción (default)

# ---------- APPLE WALLET (.pkpass — feature-flag) ----------
# Botón "Añadir a Apple Wallet" en el email de la entrada. Si falta CUALQUIERA,
# la feature queda apagada (endpoint 404, email sin botón). Todo lo demás igual.
PASS_P12_BASE64=       # el Certificates.p12 (cert Pass Type ID + clave) en base64
PASS_P12_PASSWORD=     # contraseña del .p12
PASS_WWDR_BASE64=      # el AppleWWDRCAG4.cer (DER) en base64
PASS_TYPE_ID=pass.com.pullevents.tickets
PASS_TEAM_ID=DSRBHX6N45
# PASS_ORG_NAME=511 Events   # opcional; nombre que sale en el pase
